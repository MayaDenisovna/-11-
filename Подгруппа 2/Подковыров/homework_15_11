# Задание 2
class Vehicle:
    def __init__(self, brand, model, max_speed):
        self.brand = brand
        self.model = model
        self.max_speed = max_speed
        self._speed = 0

    def __str__(self):
        return f"марка: {self.brand}, модель: {self.model}, макс. скорость: {self.max_speed}, текущая скорость: {self._speed}"

    def info(self):
        print(str(self))

    def accelerate(self, a):
        if a <= 0:
            print("скорость должна быть больше 0")
            pass
        else:
            self._speed += a
            if self._speed > self.max_speed:
                self._speed = self.max_speed
                print(f"скорость ограничена максимумом: {self._speed}")
            else:
                print(f"скорость увеличена до {self._speed}")

    def stop(self):
        self._speed = 0
        print(f"{self.brand} {self.model} остановлен")


class Car(Vehicle):
    def __init__(self, brand, model, max_speed, doors, fuel):
        super().__init__(brand, model, max_speed)
        self.doors = doors
        self.fuel = fuel

    def __str__(self):
        return super().__str__() + f", дверей: {self.doors}, топливо: {self.fuel}"

    def ac_on(self):
        print(f"кондиционер в {self.brand} {self.model} включён")


class Motorcycle(Vehicle):
    def __init__(self, brand, model, max_speed, sidecar):
        super().__init__(brand, model, max_speed)
        self.sidecar = sidecar

    def __str__(self):
        sidecar = "есть" if self.sidecar else "нет"
        return super().__str__() + f", боковой прицеп: {sidecar}"

    def maneuver(self):
        print(f"{self.brand} {self.model} выполняет маневр")


class Bicycle(Vehicle):
    def __init__(self, brand, model, max_speed, gears):
        super().__init__(brand, model, max_speed)
        self.gears = gears
        self._gear = 1

    def __str__(self):
        return super().__str__() + f", передач: {self.gears}, текущая передача: {self._gear}"

    def shift_gear(self, gear):
        if gear < 1 or gear > self.gears:
            print(f"передачи {gear} нет")
            pass
        else:
            self._gear = gear
            print(f"передача переключена на {self._gear}")


