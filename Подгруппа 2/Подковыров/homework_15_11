class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year
        self._available = True

    def __str__(self):
        status = "доступна" if self._available else "выдана"
        return f"название: {self.title}, автор: {self.author}, год: {self.year}, статус: {status}"

    def info(self):
        print(str(self))

    def is_available(self):
        return self._available

    def give_out(self):
        if not self._available:
            print(f'книга "{self.title}" уже выдана')
            pass
        else:
            self._available = False
            print(f'книга "{self.title}" выдана читателю')

    def return_book(self):
        if self._available:
            print(f'книга "{self.title}" уже в библиотеке')
            pass
        else:
            self._available = True
            print(f'книга "{self.title}" возвращена')


class Library:
    def __init__(self, name):
        self._name = name
        self._books = []

    def __str__(self):
        lines = [f'каталог библиотеки "{self._name}":']
        if not self._books:
            lines.append("книг нет")
        else:
            for book in self._books:
                lines.append(str(book))
        return "\n".join(lines)

    def add_book(self, book):
        self._books.append(book)
        print(f'книга "{book.title}" добавлена в библиотеку "{self._name}"')

    def remove_book(self, title):
        for book in self._books:
            if book.title.lower() == title.lower():
                self._books.remove(book)
                print(f'книга "{book.title}" удалена')
                return
        print(f'книга "{title}" не найдена')

    def show_all(self):
        print(str(self))

    def find_book(self, title):
        for book in self._books:
            if book.title.lower() == title.lower():
                return book
        return None

    def show_available(self):
        print("доступные книги:")
        count = 0
        for book in self._books:
            if book.is_available():
                print(str(book))
                count += 1
        if count == 0:
            print("доступных книг нет")


