class students:
    def __init__(self, name, arr = []):
        self.name = name
        self._arr = arr.copy()

    def add_grade(self, grade):
        if grade < 2 or grade > 5:
            pass
        else:
            self._arr.append(grade)

    def get_grades(self):
        for i in range(len(self._arr)):
            print(self._arr[i], end=" ")

    def get_average(self):
        if len(self._arr) == 0:
            print(0)
            pass
        else:
            s = 0
            for i in range(len(self._arr)):
                s += self._arr[i]
            print(s / len(self._arr))
    
    def get_status(self):
        s = 0
        for i in range(len(self._arr)):
            s += self._arr[i]
        avg = s / len(self._arr)
        if avg >= 4.5:
            print("great result")
        elif avg >= 3.5 and avg < 4.5:
            print("good result")
        else:
            print("bad result")

