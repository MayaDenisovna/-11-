            self._balance += a

    def pay(self, b):
        if self._balance - b <= 0:
            print("poor")
            pass
        else:
            self._balance -= b

    def info(self):
        print(f"name: {self.name}, balance: {self._balance}")

    def get_bal(self):
        print(self._balance)

